# alias config

# neo-vim
alias vim="nvim"

# replace command by lsd
alias ls='lsd'
alias l='lsd -l'
alias la='lsd -a'
alias lla='lsd -la'
alias lt='lsd --tree'

# Fast vim edit config app alias
alias configzsh="nvim $HOME/.zshrc"
alias configghossty="nvim $HOME/.config/ghostty/config"

# docker command alias
alias dockerremoveallcontainers="docker ps -aq | xargs -r docker rm -f"

alias sync_ohmyposh_theme="bash $HOME/Documents/codespace/configurations/dotfiles/scripts/oh-my-posh/sync-themes.sh"

# Reload configs
alias reloadzsh="source $HOME/.zshrc"

# K3s
alias stopk3s="sudo systemctl stop k3s k3s-agent"
alias killk3s="/usr/local/bin/k3s-killall.sh"

# Disable FN in bluetooth keyboard connect
alias disablefn="echo 2 | sudo tee /sys/module/hid_apple/parameters/fnmode"

# Starship
alias starshipconfig="nvim $HOME/.config/starship.toml"

# Git
alias gits='git status'
alias gitd='git diff'
alias gitl='git log --online --graph --decorate --all'
alias gitc='git commit -m'
alias gitf='git fetch'
alias gitp='git pull'

# Replace du by dust (du-dust)
alias du='dust'

# Replace tail by lnav

# listen ports
alias listenports='ss -ltn'

# Watch nvidia-smi
alias gpu_log="watch -n0.1 nvidia-smi"

# backup dotfiles
backup_dotfiles() {
  local dotfiles_dir="${HOME}/Documents/codespace/dotfiles"
  local current_date
  current_date=$(date +%Y-%m-%d)

  # Check if dotfiles repo exists
  if [[ ! -d "$dotfiles_dir" ]]; then
    echo "Error: Target directory $dotfiles_dir does not exist." >&2
    return 1
  fi

  # Run in a subshell () to prevent changing the current shell's working directory
  (
    set -e # Exit immediately if any command fails

    # Copy single dotfiles
    cp "${HOME}/.zshrc" "${dotfiles_dir}/zshrc.local"
    cp "${HOME}/.zsh_alias" "${dotfiles_dir}/zsh_alias.local"

    # Sync nvim folder cleanly without nesting, excluding unnecessary cache
    if command -v rsync >/dev/null 2>&1; then
      rsync -av --delete --exclude=".git" "${HOME}/.config/nvim/" "${dotfiles_dir}/nvim/"
    else
      rm -rf "${dotfiles_dir}/nvim"
      cp -r "${HOME}/.config/nvim" "${dotfiles_dir}/nvim"
    fi

    cd "$dotfiles_dir"
    git add .

    # Commit only if there are actual changes
    if git diff-index --quiet HEAD --; then
      echo "No changes detected. Nothing to commit."
    else
      git commit -m "backup dotfiles on ${current_date}"
      git push
      echo "Dotfiles successfully backed up and pushed."
    fi
  )
}

