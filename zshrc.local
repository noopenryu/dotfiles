autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)" ]; then
    compinit
else
    compinit -C
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh

autoload -Uz compinit 
if [[ -n ${ZDOTDIR}/.zcompdump(#qN.mh+24) ]]; then
	compinit;
else
	compinit -C;
fi;

# Git alias
alias gitpullrebase="git pull --rebase"
alias gitfetch="git fetch"
alias gitpush="git push"
alias gitcommit="git commit"
# Fast vim edit config app alias
alias configvim="nvim $HOME/.config/nvim/init.vim"
alias configpluginvim="nvim $HOME/.config/nvim/plugins.vim"
alias configzsh="nvim $HOME/.zshrc"
alias configghossty="nvim $HOME/.config/ghostty/config"

# docker command alias
alias dockerremoveallcontainers="docker ps -aq | xargs -r docker rm -f"

alias sync_ohmyposh_theme="bash $HOME/Documents/codespace/configurations/dotfiles/scripts/oh-my-posh/sync-themes.sh"

# Reload configs
alias reloadzsh="source $HOME/.zshrc"

# K3s
alias stopk3s="sudo systemctl stop k3s k3s-agent"
alias killk3s="/usr/local/bin/k3s-killall.sh"

# Disable FN in bluetooth keyboard connect
alias disablefn="echo 2 | sudo tee /sys/module/hid_apple/parameters/fnmode"

alias code_personal="$HOME/Documents/codespace/personal"

###### Other configurations
if [ "$TERM_PROGRAM" != "Apple_Terminal" ]; then
	eval "$(oh-my-posh init zsh --config "$HOME/.config/oh-my-posh/zash.omp.json")"
fi

#THIS MUST BE AT THE END OF THE FILE FOR SDKMAN TO WORK!!!
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
eval "$(goenv init -)"
export PATH="$GOROOT/bin:$PATH"
export PATH="$PATH:$GOPATH/bin"

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion


[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh

export KUBECONFIG=~/.kube/config
